---
type: edge
modname: exstdp
modtype: izhi_syn_stdp
param:
  - name: wmax
    value: 10
  - name: tau
    value: 20
  - name: update
    value: 1000
state:
  - name: delay
    init: uniform interval
    rep: tick
    min: 1.0
    max: 20.0
    int: 1.0
  - name: weight
    init: constant
    value: 6.0
  - name: wdelta
    init: constant
    value: 0.0
  - name: ptrace
    init: constant
    value: 0.0
  - name: ntrace
    init: constant
    value: 0.0
  - name: ptlast
    init: constant
    rep: tick
    value: 0.0
  - name: ntlast
    init: constant
    rep: tick
    value: 0.0
...

