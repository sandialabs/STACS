---
type: stream
modname: dummystr
modtype: dummy_str
param:
  - name: dp0
    value: 5.6
port:
  - name: dport
    value: /stacs/dummystr
...

---
type: vertex
modname: dummyvtx
modtype: dummy_vtx
param:
  - name: dp0
    value: 3.1
state:
  - name: v
    init: constant
    value: -65.0
  - name: u
    init: constant
    value: -13.0
...

---
type: vertex
modname: dummyvtx1
modtype: dummy_vtx
param:
  - name: dp0
    value: 2.4
state:
  - name: v
    init: constant
    value: -70.0
  - name: u
    init: constant
    value: -9.0
...

---
type: edge
modname: dummyedg
modtype: dummy_edg
param:
  - name: dp0
    value: 1.5
  - name: dp1
    value: 6.6
state:
  - name: delay
    init: bounded linear
    rep: tick
    scale: 0.5 
    offset: 1.0
    min: 1.0
    max: 20.0
  - name: weight
    init: uniform
    min: 0.9
    max: 1.1
  - name: trace
    init: constant
    value: 0.0
...
